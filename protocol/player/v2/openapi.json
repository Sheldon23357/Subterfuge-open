      "get": {
        "operationId": "get_protocol",
        "responses": {
          "200": {
            "description": "Authoritative success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Typed protocol error; unknown is not failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "schema.json#/$defs/error"
                }
              }
            }
          }
        },
        "security": []
      }
    },
