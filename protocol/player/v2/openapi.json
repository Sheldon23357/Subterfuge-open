    "/activity": {
      "get": {
        "operationId": "get_activity",
        "description": "Authorized immutable settlement facts. activity.read/1. after/through are bounded exclusive cursors from the captured observation.",
        "responses": {
          "200": {
            "description": "Authoritative success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
