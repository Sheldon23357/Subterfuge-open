{
  "openapi": "3.1.0",
  "info": {
    "title": "Subterfuge public player protocol",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "/player/v2"
    }
  ],
  "security": [
    {
      "executorBearer": []
    }
  ],
  "components": {
    "securitySchemes": {
      "executorBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Server-side scoped executor grant. Owner endpoints require a separate owner credential."
      },
      "ownerBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Existing human owner credential verified by host. Executor grants never satisfy this scheme."
      }
    }
  },
